{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "buildix/timex": "^1.1",
        "doctrine/dbal": "^3.6",
        "eduardokum/laravel-mail-auto-embed": "^2.10",
        "fedeisas/laravel-mail-css-inliner": "^5.2",
        "filament/filament": "2.17.56",
        "filament/spatie-laravel-media-library-plugin": "^2.17",
        "filipfonal/filament-log-manager": "^1.2",
        "flowframe/laravel-trend": "^0.1.5",
        "guzzlehttp/guzzle": "^7.2",
        "koalafacade/filament-crash": "^0.0.1",
        "konnco/filament-import": "^1.5",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.2",
        "laravel/tinker": "^2.8",
        "laraveldaily/laravel-invoices": "^3.0",
        "leandrocfe/filament-apex-charts": "^2.0",
        "pxlrbt/filament-activity-log": "^0.1.1",
        "ralphjsmit/laravel-filament-seo": "^1.0",
        "sgcomptech/filament-ticketing": "^1.3",
        "smodav/mpesa": "^6.2",
        "spatie/laravel-permission": "^5.10",
        "squirephp/countries-en": "^3.4",
        "squirephp/currencies-en": "^3.4",
        "tightenco/parental": "^1.3",
        "z3d0x/filament-logger": "^0.5.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.8",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0",
        "thedoctor0/laravel-factory-generator": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
