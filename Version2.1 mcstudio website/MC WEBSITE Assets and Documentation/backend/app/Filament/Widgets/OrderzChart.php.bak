<?php

namespace App\Filament\Widgets;

use App\Models\Order;
use Flowframe\Trend\Trend;
use Illuminate\Support\Carbon;
use Leandrocfe\FilamentApexCharts\Widgets\ApexChartWidget;

class OrderzChart extends ApexChartWidget
{
    protected static ?int $sort = 3;
    /**
     * Chart Id
     *
     * @var string
     */
    protected static string $chartId = 'orderzChart';

    /**
     * Widget Title
     *
     * @var string|null
     */
    protected static ?string $heading = 'OrdersChart';

    protected static ?string $pollingInterval = null;

    public ?string $filter = '0';

    protected function getFilter(): ?string
    {
        return now()->year;
    }

    protected function getFilters(): ?array
    {
        $years = range(now()->year, 2020);

        return $years;
    }


    /**
     * Chart options (series, labels, types, size, animations...)
     * https://apexcharts.com/docs/options
     *
     * @return array
     */
    protected function getOptions(): array
    {

        $activeFilter = (int) $this->filter;

        $start_time = Carbon::now()->subYears($activeFilter)->startOfYear();
        $end_time   = Carbon::now()->subYears($activeFilter)->endOfYear();
        
        $query = auth()->user()->hasRole(['Admin', 'Employee']) ? Order::query() : Order::where('user_id', authID());

        $data = Trend::query($query)
            ->between(
                start: $start_time,
                end: $end_time,
            )
            ->perMonth()
            ->count()
            ->map(fn($item) => $item->aggregate);

        return [
            'chart' => [
                'type' => 'line',
                'height' => 300,
            ],
            'series' => [
                [
                    'name' => 'Column',
                    'data' => $data,
                    'type' => 'column',
                ],
                [
                    'name' => 'Line',
                    'data' => $data,
                    'type' => 'line',
                ],
            ],
            'stroke' => [
                'width' => [0, 4],
            ],
            'xaxis' => [
                'categories' => ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                'labels' => [
                    'style' => [
                        'colors' => '#9ca3af',
                        'fontWeight' => 600,
                    ],
                ],
            ],
            'yaxis' => [
                'labels' => [
                    'style' => [
                        'colors' => '#9ca3af',
                        'fontWeight' => 600,
                    ],
                ],
            ],
            'legend' => [
                'labels' => [
                    'colors' => '#9ca3af',
                    'fontWeight' => 600,
                ],
            ],
        ];
    }
}
